# Copy to ~/.config/google-storage-cleanup/config.env (chmod 600). Loaded by the systemd units.
GMAIL_TOKEN=/path/to/gmail_token.json        # authorized-user JSON, scope gmail.modify
DRIVE_TOKEN=/path/to/drive_token.json        # scope drive (Photo Swipe step 4 deletes); drive.readonly is enough for backup
PHONE_SYNC_DIR=/path/to/storage/google-photos-sync
PHONE_ADDR=tcp://<phone tailnet ip>:22000
PHONE_NAME=My Phone
